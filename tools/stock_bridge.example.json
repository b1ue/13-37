{
  "host": "0.0.0.0",
  "port": 8737,
  "auth_token_env": "STOCK_BRIDGE_TOKEN",
  "alpha_vantage_api_key_env": "ALPHAVANTAGE_API_KEY",
  "quote_cache_seconds": 300,
  "snapshot_file": "../stock-output/watch_snapshot.json",
  "one_job_at_a_time": true,
  "presets": {
    "atlas_weekly": {
      "cwd": "../stock-program",
      "command": ["python", "atlas.py", "--preset", "weekly"]
    },
    "refresh_market_data": {
      "cwd": "../stock-program",
      "command": ["python", "atlas.py", "--refresh-only"]
    },
    "scanner": {
      "cwd": "../stock-program",
      "command": ["python", "atlas.py", "--scanner"]
    }
  }
}
